      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "source": {
      "enum": [
        "catalog",
        "database"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_label": {
      "title": "Source Label",
      "type": "string"
    },
    "entities": {
