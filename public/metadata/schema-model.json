          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "foreign_key",
            "etl"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_columns": {
          "items": {
            "type": "string"
          },
          "title": "Source Columns",
          "type": "array"
        },
        "target_columns": {
          "items": {
            "type": "string"
          },
          "title": "Target Columns",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
