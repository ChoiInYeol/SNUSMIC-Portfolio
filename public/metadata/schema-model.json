          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "producers": {
          "items": {
            "type": "string"
          },
          "title": "Producers",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "schema_name",
        "layer",
        "kind",
        "columns",
        "column_status",
        "location"
